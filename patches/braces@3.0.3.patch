new file mode 100644
index 0000000000000000000000000000000000000000..acf12e83759bd6ecc00d35fb4cdc914260b5524e
--- /dev/null
+++ b/lib/assert-depth.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// Local mitigation for GHSA-vfj7-8cjw-p6xm; retain until an upstream fixed release.
+// Validate iteratively before recursive walkers; callers cannot raise these limits.
+const MAX_DEPTH = 128;
+const MAX_NODES = 65536;
+module.exports = ast => {
+  const stack = [[ast, 0]];
+  const seen = new Set();
+  while (stack.length) {
+    const [node, depth] = stack.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth >= MAX_DEPTH || seen.has(node) || seen.size >= MAX_NODES) {
+      throw new SyntaxError('Brace pattern exceeds safe AST depth or node limit');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) stack.push([child, depth + 1]);
+    }
+  }
+};
