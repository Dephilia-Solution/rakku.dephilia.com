NEXT_PUBLIC_OWNER_URL=http://localhost:3000
NEXT_PUBLIC_POS_URL=http://localhost:3001

# Canonical public landing origin; never use a per-deployment preview URL.
SITE_URL=https://rakku.dephilia.com
# Set false only for the personal/non-production deployment. Production organization: true or unset.
SITE_INDEXABLE=true
# Optional: Search Console HTML-tag verification token (not the entire meta tag).
GOOGLE_SITE_VERIFICATION=
