{
  "name": "rakku",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:isolated": "node scripts/build-isolated.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "dev:owner": "pnpm --filter @rakku/owner dev",
    "dev:pos": "pnpm --filter @rakku/pos dev",
    "dev:superadmin": "pnpm --filter @rakku/superadmin dev",
    "dev:landing": "pnpm --filter @rakku/landing dev",
    "build:owner": "pnpm --filter @rakku/owner build",
    "build:pos": "pnpm --filter @rakku/pos build",
    "build:superadmin": "pnpm --filter @rakku/superadmin build",
    "build:landing": "pnpm --filter @rakku/landing build",
    "start": "turbo run start --parallel",
    "start:owner": "pnpm --filter @rakku/owner start",
    "start:pos": "pnpm --filter @rakku/pos start",
    "start:superadmin": "pnpm --filter @rakku/superadmin start",
    "start:landing": "pnpm --filter @rakku/landing start",
    "seed": "tsx scripts/seed.ts",
    "seed:full": "tsx scripts/seed-full.ts",
    "backfill:owners": "tsx scripts/backfill-owners.ts",
    "db:migrate": "tsx scripts/neon-migrate.ts",
    "db:inspect": "tsx scripts/neon-inspect.ts",
    "db:provision": "tsx scripts/neon-provision-runtime.ts",
    "db:seed": "tsx scripts/neon-seed.ts",
    "db:demo": "tsx scripts/neon-seed-demo.ts",
    "db:copy": "tsx scripts/neon-copy.ts",
    "db:images": "tsx scripts/neon-migrate-images.ts",
    "db:check": "tsx scripts/neon-check.ts",
    "db:smoke": "tsx scripts/neon-smoke.ts",
    "smoke:http": "tsx scripts/neon-http-smoke.ts",
    "smoke:production": "tsx scripts/neon-production-smoke.ts",
    "admin:status": "tsx scripts/neon-admin-status.ts",
    "auth:check": "tsx scripts/neon-auth-check.ts",
    "env:check": "tsx scripts/neon-env-check.ts",
    "test:env": "tsx --test scripts/lib/environment-policy.test.ts",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "admin:invite": "tsx scripts/invite-superadmin.ts",
    "test:db": "pnpm --filter @rakku/db test",
    "test:auth": "tsx --test packages/auth-utils/src/*.test.ts",
    "test:observability": "pnpm --filter @rakku/observability test",
    "test:provider": "tsx --test packages/vessel-client/src/*.test.ts",
    "test:concurrency": "node scripts/test-financial-concurrency.mjs",
    "provider:jobs": "tsx scripts/provider-jobs.ts",
    "ops:snapshot": "tsx scripts/ops-snapshot.ts",
    "ops:cleanup": "tsx scripts/ops-cleanup.ts",
    "ops:checkout-pause": "tsx scripts/ops-checkout-pause.ts",
    "ops:restore-verify": "tsx scripts/ops-restore-verify.ts",
    "db:test:migrate": "node scripts/apply-test-migrations.mjs",
    "audit:summary": "node scripts/dependency-audit-summary.mjs dependency-audit.json",
    "test:auth:http": "node scripts/test-auth-http.mjs",
    "test:demo": "pnpm --filter @rakku/demo test",
    "test:demo:browser": "node packages/demo/e2e/run-production.mjs --routed"
  },
  "devDependencies": {
    "@rakku/db": "workspace:*",
    "@rakku/silos-client": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "postgres": "3.4.8",
    "sharp": "^0.35.5",
    "tsx": "^4.22.4",
    "turbo": "^2.11.8",
    "typescript": "^5.9.3"
  }
}
